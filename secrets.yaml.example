# secrets.yaml.example
# Copy this file to secrets.yaml and fill in your values.
# NEVER commit secrets.yaml to git!

# WiFi credentials
wifi_ssid: "YourWiFiSSID"
wifi_password: "YourWiFiPassword"
wifi_domain: ".local"              # or ".home.lan", ".yourdomain.com", etc.

# API encryption key (generate one with: esphome wizard)
# Must be a valid base64-encoded 32-byte key
api_encryption_key: "REPLACE_WITH_BASE64_KEY"

# OTA update password
ota_password: "REPLACE_WITH_OTA_PASSWORD"
